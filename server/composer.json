{
    "name": "crm/server",
    "description": "CRM backend API (PHP + PostgreSQL)",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "vlucas/phpdotenv": "^5.6",
        "spomky-labs/otphp": "^11.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "//": "The dev server is meant to run until you stop it. Composer kills a script at 300s by default, which was ending `composer start` mid-session.",
        "process-timeout": 0
    },
    "scripts": {
        "start": "php -S localhost:8000 -t public",
        "seed-attendance": "php database/seed_attendance_dev.php"
    }
}
